# ---------------------------------------------------------------------------
# TelcoMAS LLM configuration (OpenAI-compatible)
# Copy this file to `.env` and fill in your key.
# ---------------------------------------------------------------------------

# --- Option A: OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Option B: DeepSeek (OpenAI-compatible) ---
# OPENAI_API_KEY=sk-your-deepseek-key-here
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# --- Behaviour knobs ---
# Sampling temperature for the agents (0.0 = most deterministic reasoning).
TELCO_TEMPERATURE=0.1
# Optional request seed for providers that support OpenAI-compatible seeded chat.
# Leave unset for providers that reject the seed parameter.
# TELCO_LLM_SEED=20260706
# Cache real LLM responses on disk so benchmark re-runs are cheap & reproducible.
# The benchmark forces this on regardless; for the live demo it defaults to off.
LLM_CACHE=0
# Max tool-calling iterations per agent before it must give a final answer.
TELCO_MAX_TOOL_ITERS=6
